rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin via custom claims
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /menu/{document=**} {
      // Tout le monde peut voir le menu
      allow read: if true;
      
      // Seuls les administrateurs avec le claim "admin" peuvent modifier
      allow write: if isAdmin();
    }

    match /audit_logs/{logId} {
      // Seuls les administrateurs peuvent voir les logs d'audit
      allow read: if isAdmin();
      // Permettre la création de logs d'audit par les admins (ou via Cloud Functions)
      allow create: if isAdmin();
      // Interdire la modification et la suppression pour garantir l'intégrité de l'audit
      allow update, delete: if false;
    }
  }
}
